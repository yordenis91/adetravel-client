# Variables del cliente (Vite). Se leen AL CONSTRUIR la imagen, no al arrancar: en Easypanel van en
# las variables del servicio y cambiar una exige reconstruir. Todo lo VITE_* queda visible en el
# navegador: nunca poner aquí secretos.

# URL de la API, con el sufijo /api. Sin ella, en producción se usa "/api" (mismo dominio).
VITE_API_URL=https://api.tu-dominio.cl/api

# Sentry del navegador (opcional). Los eventos salen sin datos personales (src/lib/sentry-scrub.ts).
# VITE_SENTRY_DSN=
# Para separar la demo de producción en Sentry (por defecto, production en el build).
# VITE_SENTRY_ENVIRONMENT=production
