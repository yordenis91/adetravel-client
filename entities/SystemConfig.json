{
    "name": "SystemConfig",
    "description": "Global system configuration for ADE Travel",
    "properties": {
      "agencyName": { "type": "string", "description": "Legal agency name" },
      "agencyFantasyName": { "type": "string", "description": "Commercial/fantasy name" },
      "agencyRut": { "type": "string", "description": "Chilean RUT of the agency" },
      "agencyAddress": { "type": "string", "description": "Physical address" },
      "agencyPhone": { "type": "string", "description": "Main phone number" },
      "agencyEmail": { "type": "string", "description": "Main contact email" },
      "agencyWebsite": { "type": "string", "description": "Agency website URL" },
      "agencyLogoUrl": { "type": "string", "description": "URL of the agency logo" },
      "smtpHost": { "type": "string", "description": "SMTP server host" },
      "smtpPort": { "type": "number", "description": "SMTP server port" },
      "smtpUser": { "type": "string", "description": "SMTP username" },
      "smtpPassword": { "type": "string", "description": "SMTP password (stored)" },
      "smtpFromName": { "type": "string", "description": "Sender display name" },
      "smtpFromEmail": { "type": "string", "description": "Sender email address" },
      "smtpEncryption": { "type": "string", "description": "TLS or SSL" },
      "notifyOnQuotationSent": { "type": "boolean", "description": "Send email when quotation is sent" },
      "notifyOnPaymentCompleted": { "type": "boolean", "description": "Send email when payment is completed" },
      "notifyOnVoucherIssued": { "type": "boolean", "description": "Send email when voucher is issued" },
      "notifyOnRequestCreated": { "type": "boolean", "description": "Notify internally when a new request is created" },
      "defaultCurrency": { "type": "string", "description": "CLP or USD" },
      "defaultTaxPercentage": { "type": "number", "description": "Default IVA percentage (e.g. 19)" },
      "defaultQuotationValidityDays": { "type": "number", "description": "Default days before a quotation expires" },
      "defaultTermsAndConditions": { "type": "string", "description": "Default T&C text for quotations" },
      "defaultQuotationNotes": { "type": "string", "description": "Default footer notes for quotations" },
      "requestNumberPrefix": { "type": "string", "description": "e.g. ADET" },
      "quotationNumberPrefix": { "type": "string", "description": "e.g. COTIZ" },
      "paymentNumberPrefix": { "type": "string", "description": "e.g. PAG" },
      "voucherNumberPrefix": { "type": "string", "description": "e.g. VCH" },
      "timezone": { "type": "string", "description": "e.g. America/Santiago" }
    }
  }